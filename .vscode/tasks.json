{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All Packages",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "Build Common Package",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "--filter",
                "@safe-spend/common",
                "build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "Install Dependencies",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "install"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}