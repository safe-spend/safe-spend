# ==============================================================================
# SafeSpend Monorepo .gitignore
# ==============================================================================

# Operating System Files
# ==============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Node.js & Package Managers
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Package manager lock files (choose one strategy)
# Uncomment the approach you prefer:
# Option 1: Keep all lock files
# Option 2: Ignore all lock files
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Runtime & Environment
# ==============================================================================
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Logs
logs
*.log
pids
*.pid
*.seed
*.pid.lock

# Coverage & Testing
# ==============================================================================
coverage/
*.lcov
.nyc_output
.coverage
.pytest_cache/
.tox/

# IDE & Editor Files
# ==============================================================================
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# JetBrains
.idea/
*.iws
/out/

# Android Specific
# ==============================================================================
# Android Studio
.gradle/
build/
local.properties
*.iml
.idea/
*.hprof
.cxx/
.externalNativeBuild/

# Android Keystore (keep debug keystore for development)
*.keystore
!debug.keystore

# Android NDK
obj/

# Generated files
bin/
gen/
out/

# Gradle Wrapper (keep these for consistent builds)
# gradle/wrapper/gradle-wrapper.jar
# gradle/wrapper/gradle-wrapper.properties

# iOS Specific
# ==============================================================================
# Xcode
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.xcuserstate
project.xcworkspace/

# CocoaPods
Pods/
!Podfile
!Podfile.lock

# Carthage
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# React Native Specific
# ==============================================================================
# Metro bundler
.metro-health-check*
*.jsbundle

# React Native CLI
.react-native/

# Flipper
.flipper/

# Bundle artifacts
*.bundle
*.js.map

# Desktop App Specific (Electron, Tauri, etc.)
# ==============================================================================
# Electron
dist/
dist-electron/
*.app
*.dmg
*.deb
*.rpm
*.exe
*.msi

# Tauri
src-tauri/target/

# Build outputs
apps/desktop/dist/
apps/desktop/build/
apps/desktop/out/

# Temporary & Cache Files
# ==============================================================================
# Runtime
*.tmp
*.temp
.cache/
.parcel-cache/

# OS generated files
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Development & Build Tools
# ==============================================================================
# Webpack
.webpack/

# Rollup
.rollup.cache/

# ESLint
.eslintcache

# TypeScript
*.tsbuildinfo

# Turbo
.turbo/

# Rush
common/temp/
common/deploy/

# Nx
.nx/cache/

# Database & Data Files
# ==============================================================================
*.sqlite
*.sqlite3
*.db

# Backup files
*.bak
*.backup
*.old

# Archive files
*.zip
*.tar.gz
*.rar
*.7z

# Security & Sensitive Files
# ==============================================================================
# Environment variables
.env*
!.env.example

# API keys and secrets
secrets/
*.pem
*.p12
*.key
*.crt
*.cer

# Project Specific
# ==============================================================================
# Custom build outputs
/build
/dist

# Documentation builds
/docs/build

# Package-specific ignores
packages/*/dist/
packages/*/build/
packages/*/lib/

# Monorepo specific
lerna-debug.log*

# Comments for team
# ==============================================================================
# Add any project-specific files or directories below:
# /custom-folder/
# specific-file.txt
